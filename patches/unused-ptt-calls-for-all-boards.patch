diff --git a/esp32/components/muse/Kconfig b/esp32/components/muse/Kconfig
index ebc9a8d..97539d1 100644
--- a/esp32/components/muse/Kconfig
+++ b/esp32/components/muse/Kconfig
@@ -520,6 +520,20 @@ if MUSE_REALTIME_VOICE
         bool "Muse says hello when a call starts"
         default n
 
+    config MUSE_PTT_CALLS
+        bool "Hold the talk button to talk in a live call (push-to-talk calls)"
+        depends on MUSE_REALTIME_VOICE
+        default y if MUSE_BOARD_M5STACK_STOPWATCH
+        default n
+        help
+            Holding the talk button opens a live call (if one isn't open) and
+            streams your voice while held; on release Muse answers out loud,
+            with captions, and the call stays open for the next hold. It ends
+            after MUSE_REALTIME_VOICE_IDLE_S quiet seconds, or on the hang-up
+            button (blue on the StopWatch, the aux button on other touch
+            boards). Settings > Sound > Voice notes switches back to text-reply
+            voice notes. (muse-charm local patch: was StopWatch-only.)
+
     config MUSE_REALTIME_VOICE_AEC_DUPLEX
         bool "Keep the mic open while Muse talks if echo is cancelled"
         depends on HOMEHUB_VOICE
diff --git a/esp32/components/muse/muse_input.c b/esp32/components/muse/muse_input.c
index 50147a5..66c6a6e 100644
--- a/esp32/components/muse/muse_input.c
+++ b/esp32/components/muse/muse_input.c
@@ -239,6 +239,19 @@ static void aux_button(bool pressed, bool edge)
     if (edge && pressed) {
         held = 0;
         hinted = false;
+#if CONFIG_MUSE_PTT_CALLS && !CONFIG_MUSE_BOARD_M5STACK_STOPWATCH
+        /* muse-charm: in a push-to-talk call, or with its press still on the
+         * way, the aux button hangs up (the StopWatch uses blue for this). It
+         * wakes the screen, and its release doesn't then sleep it. */
+        if (muse_voice_ptt_enabled() && (muse_voice_in_call() || atomic_load(&s_call_pending))) {
+            muse_state_poke();
+            set_asleep(false, muse_board->aux_button);
+            post(MUSE_PTT_END_CALL, false);
+            sleep_in = 0;
+            swallow = true;
+            return;
+        }
+#endif
         swallow = muse_state_asleep();
         if (swallow) {
             set_asleep(false, muse_board->aux_button);
