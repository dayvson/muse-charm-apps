+// and rodata in PSRAM). The caller's own stack may be in PSRAM either way.
+// muse-charm: helper_task_* so live-voice builds whose internal heap is too
+// fragmented for an 8 KB block can still look up the VM.
 static void hatch_vm_task(void *arg) {
     hatch_vm_request_t *req = arg;
     if (config_is_provisioned() && operation_gate_take(pdMS_TO_TICKS(15000), "Muse VM lookup")) {
@@ -2476,7 +2479,7 @@ static void hatch_vm_task(void *arg) {
     }
     xTaskNotifyGive(req->waiter);
     stack_monitor_record(NULL);
-    vTaskDelete(NULL);
+    helper_task_delete(NULL);
 }
 
