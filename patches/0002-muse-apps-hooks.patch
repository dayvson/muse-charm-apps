diff --git a/esp32/components/muse/muse_voice.c b/esp32/components/muse/muse_voice.c
index 26307ed..21df6c6 100644
--- a/esp32/components/muse/muse_voice.c
+++ b/esp32/components/muse/muse_voice.c
@@ -38,6 +38,9 @@
 #include "muse_settings.h"
 #include "muse_state.h"
 #include "muse_wifi.h"
+#if CONFIG_MUSE_APPS
+#include "muse_apps.h"   /* muse-charm: Lua apps' sound */
+#endif
 #if CONFIG_MUSE_REALTIME_VOICE
 #include "muse_voice_call.h"
 #include "muse_voice_call_core.h"
@@ -1377,8 +1380,28 @@ static void voice_task(void *arg)
                 }
                 continue;
             }
+#if CONFIG_MUSE_APPS
+            /* muse-charm: a Lua app's sound, only while there's nothing else
+             * to do (a call, a note or a reply never shares the speaker). A
+             * 20 ms write paces the loop as the read does. */
+            static bool s_app_sound;
+            if (muse_apps_sound_pull(s_chunk, MUSE_AUDIO_CHUNK)) {
+                if (!s_app_sound) {
+                    s_app_sound = true;
+                    pre_reset();
+                }
+                muse_audio_write(s_chunk, MUSE_AUDIO_CHUNK);
+            } else {
+                if (s_app_sound) {
+                    s_app_sound = false;
+                    pre_reset();   /* the speaker's tail isn't pre-roll */
+                }
+                idle_capture();
+            }
+#else
             /* The 20 ms read paces this loop. */
             idle_capture();
+#endif
             if (xQueueReceive(s_queue, &ev, 0) != pdTRUE) {
                 continue;
             }
