@@ -87,7 +87,18 @@ typedef struct {
 // at the result-queue boundary, before every control chunk, tunnel batch and
 // ping. Download admission also leaves this margin after its allocations.
 // It is not a contiguous-allocation requirement or a reservation.
+// muse-charm: with the home-network tunnel off there are no 8 KiB tunnel
+// batches, and with live voice and the apps on, the Waveshare 1.75C idles at
+// 13-17 KiB of free DMA RAM: under 16 KiB, link.register waited forever and no
+// command reached the board. 12 KiB keeps the margin for control messages.
+#ifdef ESP_PLATFORM
+#include "sdkconfig.h"
+#endif
+#if defined(CONFIG_MUSE_APPS) && !defined(CONFIG_HOMEHUB_TUNNEL)
+#define NOISE_TX_DMA_RESERVE_BYTES (12 * 1024)
+#else
 #define NOISE_TX_DMA_RESERVE_BYTES (16 * 1024)
